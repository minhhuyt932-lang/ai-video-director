# 复制到项目根目录，改名为 .env.local 后填写。.env.local 不要提交到 git，不要发给别人，也不要贴进对话。

# ---- 视频：Seedance（火山方舟官方或结构相同的第三方中转）----
SEEDANCE_API_KEY=
# 官方：https://ark.cn-beijing.volces.com ；第三方填它给的地址（不带 /api/v3）
SEEDANCE_BASE_URL=
# 模型名，各家叫法可能不同，如 doubao-seedance-2-5-260628
SEEDANCE_MODEL=
# 选填：720p 每秒单价（元），用于提交前报价
SEEDANCE_PRICE_PER_SEC=

# ---- 生图：ChatGPT（OpenAI 兼容）图像 API ----
IMAGE_API_KEY=
# 选填：默认 https://api.openai.com/v1 ；第三方填它的 /v1 地址
IMAGE_BASE_URL=
# 选填：默认 gpt-image-2
IMAGE_MODEL=
